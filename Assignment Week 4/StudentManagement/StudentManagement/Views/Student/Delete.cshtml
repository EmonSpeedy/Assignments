@model StudentManagement.Models.Student
@{
    ViewData["Title"] = "Delete Student";
}

<div class="card shadow-sm p-4">
    <h3 class="mb-3 text-danger">Delete Student</h3>

    <p>Are you sure you want to delete this student?</p>

    <ul class="list-group mb-3">
        <li class="list-group-item"><strong>Name:</strong> @Model.Name</li>
        <li class="list-group-item"><strong>Email:</strong> @Model.Email</li>
        <li class="list-group-item"><strong>Department:</strong> @Model.Department</li>
    </ul>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>

</div>
